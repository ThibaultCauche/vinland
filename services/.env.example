# Modele de configuration des services Vinland.
# Sur le NAS : copier ce fichier en services/.env et remplir les valeurs.
# services/.env est gitignore : il ne doit JAMAIS etre commite (depot public).
#
# Les noms marques « a confirmer » sont deduits du code de l'app ; ils seront
# verifies quand le code Python des services sera ajoute au depot.

# --- Ports ecoutes sur le NAS (lies a 127.0.0.1, Tailscale serve route vers eux)
JAM_RELAY_PORT=8765
AVATAR_SERVER_PORT=8766        # a confirmer
SHARE_INBOX_PORT=8767          # a confirmer
DOWNLOAD_WORKER_PORT=8768      # a confirmer

# --- jam-relay, mode Soiree : compte Navidrome « soiree » SANS droits
# d'admin (le relais ne fait que chercher des titres et lire les pochettes).
# URL vue depuis le conteneur, par ex. http://host.docker.internal:4533 ou
# l'URL Tailscale du NAS. Laisser vide pour desactiver les soirees.
PARTY_NAVIDROME_URL=
PARTY_NAVIDROME_USER=soiree
PARTY_NAVIDROME_PASSWORD=

# --- Cles partagees avec l'app (en-tete X-Api-Key). Meme valeur que dans
# lib/config/*_config.dart cote app. Generer avec : openssl rand -hex 32
AVATAR_API_KEY=
SHARE_INBOX_API_KEY=
DOWNLOAD_WORKER_API_KEY=

# --- download-worker (a confirmer)
# Dossier de la bibliotheque musicale sur le NAS (le meme que Navidrome lit).
MUSIC_DIR=/volume1/music
NAVIDROME_URL=http://navidrome:4533
NAVIDROME_USER=
NAVIDROME_PASS=
LIDARR_URL=
LIDARR_API_KEY=
LIDARR_TIMEOUT_SECONDS=900
# Taille max d'un lot d'import envoye par l'app (500 Mo par defaut).
MAX_IMPORT_BODY_BYTES=524288000
